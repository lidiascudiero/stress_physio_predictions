   "source": [
    "# Environment and Setup\n",
    "\n",
    "Scope: Environment and setup in the WESAD protocol.\n",
    "\n",
    "Input: `configs/config.yaml` and `requirements.txt`.\n",
    "\n",
    "Output and saved artifacts: `environment and directory snapshot` (under the configured output root; real `.parquet`, synthetic `.csv`).\n",
    "\n",
    "Dependencies: Environment from `requirements.txt`, `src/` modules; setup dependencies only in notebook 00.\n",
    "\n",
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "cell-001",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Data mode: REAL WESAD\n"
     ]
    }
   ],
   "source": [
    "from pathlib import Path\n",
    "import os, sys\n",
    "HERE = Path.cwd().resolve()\n",
    "ROOT = next((p for p in (HERE, *HERE.parents) if (p / 'configs/config.yaml').is_file() and (p / 'src').is_dir()), None)\n",
    "if ROOT is None:\n",
    "    raise RuntimeError('Start Jupyter inside the project folder; no machine-specific path is required')\n",
    "os.chdir(ROOT)\n",
    "if str(ROOT) not in sys.path: sys.path.insert(0, str(ROOT))\n",
    "from src.config import load, setup, smoke_config\n",
    "from src import workflow as w\n",
    "SYNTHETIC = os.environ.get('WESAD_SYNTHETIC', '0') == '1'\n",
    "c = load()\n",
    "if SYNTHETIC: c = smoke_config(c)\n",
    "\n",
    "# Reuse saved protocol instead of silently resetting extraction settings.\n",
    "if not SYNTHETIC:\n",
    "    import copy, json\n",
    "    from src.config import fingerprint\n",
    "    protocol_file = w.root(c) / 'protocol_lock.json'\n",
    "    if protocol_file.is_file():\n",
    "        from src.provenance import verify_lock\n",
    "        saved_protocol = verify_lock(protocol_file)\n",
    "        frozen = saved_protocol['config']\n",
    "        if fingerprint(frozen) != saved_protocol['config_sha256']:\n",
    "            raise ValueError('Saved protocol hash mismatch')\n",
    "        c = copy.deepcopy(frozen)\n",
    "\n",
    "setup(c)\n",
    "print('Data mode:', 'SYNTHETIC EXECUTION ONLY' if SYNTHETIC else 'REAL WESAD')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "cell-002",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "{\n",
      "  \"python\": \"3.12.7\",\n",
      "  \"platform\": \"Windows-11-10.0.26300-SP0\",\n",
      "  \"packages\": {\n",
      "    \"numpy\": \"2.4.2\",\n",
      "    \"pandas\": \"3.0.6\",\n",
      "    \"scipy\": \"1.15.3\",\n",
      "    \"scikit-learn\": \"1.7.2\",\n",
      "    \"matplotlib\": \"3.10.3\",\n",
      "    \"seaborn\": \"0.13.2\",\n",
      "    \"neurokit2\": \"not installed\",\n",
      "    \"heartpy\": \"not installed\",\n",
      "    \"tqdm\": \"4.67.1\",\n",
      "    \"pyyaml\": \"6.0.3\",\n",
      "    \"pytest\": \"8.4.1\",\n",
      "    \"pyarrow\": \"22.0.0\"\n",
      "  }\n",
      "}\n",
      "Disk free GB: 397.93772544\n",
      "RAM GB: 34.049417216\n",
      "No accessible GPU; all models use CPU\n",
      "Retained requirements.txt; environment snapshot written.\n"
     ]
    }
   ],
   "source": [
    "import json, platform, shutil, subprocess\n",
    "from src.config import environment\n",
    "print(json.dumps(environment(), indent=2))\n",
    "print('Disk free GB:', shutil.disk_usage(ROOT).free / 1e9)\n",
    "try:\n",
    "    import psutil\n",
    "    print('RAM GB:', psutil.virtual_memory().total / 1e9)\n",
    "except ImportError:\n",
    "    print('RAM: psutil not installed')\n",
    "try:\n",
    "    p = subprocess.run(['nvidia-smi', '--query-gpu=name,memory.total', '--format=csv'], capture_output=True, text=True, timeout=10)\n",
    "    print(p.stdout or 'No accessible GPU')\n",
    "except (FileNotFoundError, subprocess.TimeoutExpired):\n",
    "    print('No accessible GPU; all models use CPU')\n",
    "# Opt-in bootstrap: the kernel must then be switched to this environment.\n",
    "CREATE_AND_INSTALL = False\n",
    "if CREATE_AND_INSTALL:\n",
    "    subprocess.check_call([sys.executable, '-m', 'venv', str(ROOT / '.venv')])\n",
    "    python = ROOT / '.venv' / ('Scripts/python.exe' if os.name == 'nt' else 'bin/python')\n",
    "    subprocess.check_call([str(python), '-m', 'pip', 'install', '-r', 'requirements.txt'])\n",
    "    subprocess.check_call([str(python), '-m', 'ipykernel', 'install', '--user', '--name', 'wesad'])\n",
    "# Never overwrite the reviewed project requirements with unrelated kernel packages.\n",
    "freeze = subprocess.run([sys.executable, '-m', 'pip', 'freeze'], capture_output=True, text=True, check=True)\n",
    "(ROOT / c['output']['root'] / 'reports/environment.freeze.txt').write_text(freeze.stdout)\n",
    "w.write_json(ROOT / c['output']['root'] / 'reports/environment.json', environment())\n",
    "print('Retained requirements.txt; environment snapshot written.')\n"
   ]
  }
 ],
